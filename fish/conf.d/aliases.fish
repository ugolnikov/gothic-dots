# Аббревиатуры (разворачиваются после пробела — удобно, видно финальную команду)
abbr l     'eza -l'
abbr ll    'ls -alF'
abbr la    'ls -A'
abbr ..    'cd ..'
abbr ...   'cd ../..'
abbr ....  'cd ../../..'
abbr home  'cd ~'
abbr c     'clear'
abbr cls   'clear; and ls'
abbr v     'vim'
abbr m     'micro'
abbr fd    'fdfind'
abbr f     'fdfind'
abbr ff    'fastfetch'
abbr b     'bat'

abbr gs    'git status'
abbr ga    'git add .'
abbr gc    'git commit -m'
abbr gp    'git push'
abbr gl    'git log --oneline --graph'

abbr update   'sudo apt update'
abbr upgrade  'sudo apt update && sudo apt upgrade'
abbr cleanup  'sudo apt update; and sudo apt autoremove -y; and sudo apt autoclean; and sudo apt clean'
abbr df    'df -h'
abbr du    'du -sh *'
abbr free  'free -m -h'
abbr myip  'curl ifconfig.me'
abbr ports 'netstat -tulanp'
abbr untar 'tar -zxvf'

# Безопасные алиасы (работают в т.ч. в скриптах, не только интерактивно)
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias ln='ln -i'
alias mkdir='mkdir -pv'

# Цветной вывод (тоже алиасы — нужны для совместимости)
alias ls='ls --color=auto'
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
