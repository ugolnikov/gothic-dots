# --- Secrets: never commit (see README) ---
# The *.EXAMPLE templates in fish/ ARE tracked on purpose.
fish/secrets.fish
.secrets.fish
.secrets.sh
claude/settings.local.json

# --- Runtime state written into tracked config dirs ---
config/micro/backups/
config/micro/buffers/
fish/fish_variables

# --- Runtime choices written by the settings app (scripts/settings.sh) ---
config/hypr/dynamic-theme
config/hypr/light-theme
config/hypr/palette-mode
config/hypr/random-wallpaper
config/hypr/terminal
config/hypr/notifications
config/hypr/layout
config/hypr/conf.d/layout.dynamic.conf
config/hypr/conf.d/animations.dynamic.conf

# --- Session toggles (scripts/controls.sh) and saved layouts (scripts/session.sh) ---
config/hypr/dnd
config/hypr/night-light
config/hypr/caffeine
config/hypr/recording
config/hypr/sessions/

# --- Ambience schedule (scripts/ambience.sh) ---
config/hypr/ambience
config/hypr/ambience.conf
config/hypr/ambience-slot
config/hypr/ambience-wall
config/hypr/ambience-rotated
config/hypr/presets.local/
config/hypr/preset-active
config/hypr/preset-previous
config/hypr/eventd.conf
config/hypr/windowrules.tsv
config/hypr/eventd.d/
config/hypr/eventd-share

# --- Per-machine Hyprland overrides (seeded from *.EXAMPLE by install.sh) ---
config/hypr/conf.d/*.local.conf

# --- Generated palette (wallust) and the current wallpaper ---
# Keep this list in step with palette.sh's TARGETS: scripts/check-palette-targets.sh enforces it.
config/hypr/conf.d/colors.dynamic.conf
config/hypr/wallpaper.png
config/waybar/colors.dynamic.css
config/rofi/colors.dynamic.rasi
config/kitty/colors.dynamic.conf
config/swaync/colors.dynamic.css
config/foot/colors.dynamic.ini
config/tmux/colors.dynamic.conf
config/gtk-3.0/colors.dynamic.css
config/gtk-4.0/colors.dynamic.css
config/fish/colors.dynamic.fish

# --- Editor / OS junk ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.netrwhist
.idea/
.vscode/
