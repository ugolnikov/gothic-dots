{
  // fastfetch config — https://github.com/fastfetch-cli/fastfetch
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "/root/dotfiles/config/fastfetch/logo.txt",
    "padding": {
      "left": 2
    }
  },

  "display": {
    "separator": "  →  ",
    "color": {
      "keys": "default",
      "separator": "#666666"
    }
  },

  "modules": [
    "title",
    {
      "type": "separator",
      "custom": "───────  system  ───────"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "separator",
      "custom": "──────  hardware  ──────"
    },
    "cpu",
    "gpu",
    "memory",
    "disk",
    {
      "type": "separator",
      "custom": "──────  display  ───────"
    },
    "wm",
    "de",
    "terminal",
    "terminalfont",
    "localip",
    {
      "type": "separator",
      "custom": "───────  theme  ────────"
    },
    "colors",
  ]
}
