# Настройки eventd.sh. Скопируй в ~/.config/hypr/eventd.conf.
#
# Классы окон (glob через запятую), при открытии которых включается «не
# беспокоить» и снимается кофеин; закрытие этого окна возвращает состояние.
# Пусто/нет файла — шаринг не отслеживается.
# share_classes=xdg-desktop-portal-gnome,org.gnome.ScreenShare
